# Copy to .env to run the docker-compose stack against Cloudflare R2 instead of
# the bundled MinIO (`make dev-r2`). .env is git-ignored.
#
# In the Cloudflare dashboard: R2 -> create bucket "rigforge-dev", then
# "Manage R2 API tokens" -> create a token with Object Read & Write on that
# bucket. The token page shows the three values below.

# https://<account id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# The browser PUTs parts to the same host, so the public endpoint is identical.
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=rigforge-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The bucket already exists on R2; the api must not try to create it.
S3_CREATE_BUCKET=false

# The browser talks to R2 directly, so the bucket needs a CORS policy that
# allows PUT/GET from the web app's origin and exposes the ETag header.
# Apply docs/r2-cors.json in the bucket's settings (R2 -> bucket -> Settings ->
# CORS policy).
