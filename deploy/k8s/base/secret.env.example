# Template for the Secret. Copy to deploy/k8s/overlays/<name>/secret.env and
# fill in real values; that file is git-ignored and never committed. Kustomize
# turns it into the Secret "rigforge-secrets" (see the overlay's
# secretGenerator). `make deploy-kind` generates one with throwaway values.
POSTGRES_PASSWORD=change-me
# R2: an API token's Access Key ID and Secret Access Key with read/write
# access to the bucket.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
