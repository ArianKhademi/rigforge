# Copy to config.env and fill in. Not secret, but specific to your account.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=rigforge-dev
# Upload size cap for the public instance (4 GiB; the default is 50 GiB).
UPLOAD_MAX_SIZE=4294967296
